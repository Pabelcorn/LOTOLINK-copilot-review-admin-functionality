# =============================================================================
# LOTOLINK - Production Environment Variables
# =============================================================================
# INSTRUCCIONES:
# 1. Copiar este archivo a .env.production
# 2. Reemplazar todos los valores con los reales
# 3. NUNCA commitear .env.production al repositorio
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=lotolink_prod
DATABASE_USER=lotolink_user
DATABASE_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO
DATABASE_SSL=true

# -----------------------------------------------------------------------------
# JWT AUTHENTICATION
# -----------------------------------------------------------------------------
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GENERAR_SECRETO_DE_64_CARACTERES_MINIMO
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=GENERAR_OTRO_SECRETO_DIFERENTE
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# ADMIN SECRET CODES (Hashed with bcrypt)
# -----------------------------------------------------------------------------
# Generar hash: node scripts/generate-admin-hash.js LOT20041227
# El código real (LOT20041227) solo lo conocen los administradores
ADMIN_SECRET_HASH_SUPER=$2b$10$REEMPLAZAR_CON_HASH_REAL
ADMIN_SECRET_HASH_REGULAR=$2b$10$REEMPLAZAR_CON_HASH_REAL

# Credenciales del panel admin (también hasheadas)
ADMIN_PANEL_USERNAME=admin
ADMIN_PANEL_PASSWORD_HASH=$2b$10$REEMPLAZAR_CON_HASH_REAL

# -----------------------------------------------------------------------------
# SMS GATEWAY - OTP (Elegir uno)
# -----------------------------------------------------------------------------
# Opción 1: Twilio (Recomendado para República Dominicana)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+18091234567
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opción 2: AWS SNS
# SMS_PROVIDER=aws_sns
# AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
# AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AWS_REGION=us-east-1
# AWS_SNS_SENDER_ID=LOTOLINK

# -----------------------------------------------------------------------------
# OTP CONFIGURATION
# -----------------------------------------------------------------------------
OTP_LENGTH=6
OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_BLOCK_DURATION_MINUTES=30

# -----------------------------------------------------------------------------
# OAUTH - GOOGLE
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=xxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_CALLBACK_URL=https://lotolink.com/auth/google/callback

# -----------------------------------------------------------------------------
# OAUTH - APPLE
# -----------------------------------------------------------------------------
APPLE_CLIENT_ID=com.lotolink.app
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_KEY_ID=XXXXXXXXXX
APPLE_PRIVATE_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8
APPLE_CALLBACK_URL=https://lotolink.com/auth/apple/callback

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10
ADMIN_ACCESS_RATE_LIMIT_MAX=3

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
CORS_ORIGINS=https://lotolink.com,https://www.lotolink.com,https://app.lotolink.com
BCRYPT_ROUNDS=12
SESSION_SECRET=GENERAR_SECRETO_PARA_SESIONES

# -----------------------------------------------------------------------------
# SSL/HTTPS
# -----------------------------------------------------------------------------
SSL_ENABLED=true
SSL_CERT_PATH=/etc/letsencrypt/live/lotolink.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/lotolink.com/privkey.pem

# -----------------------------------------------------------------------------
# STRIPE (Pagos)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=REEMPLAZAR_CON_TU_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=REEMPLAZAR_CON_TU_STRIPE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=REEMPLAZAR_CON_TU_STRIPE_WEBHOOK_SECRET

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
API_BASE_URL=https://api.lotolink.com
FRONTEND_URL=https://lotolink.com
ADMIN_PANEL_URL=https://admin.lotolink.com

# -----------------------------------------------------------------------------
# LOGGING & MONITORING
# -----------------------------------------------------------------------------
LOG_LEVEL=info
SENTRY_DSN=https://xxxxxxxx@sentry.io/xxxxxxx
